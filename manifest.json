{
  "name": "Coursera Clone (v1: skip video/reading + discussing)",
  "description": "1:1 clone of prototype learning-skip logic with full logging. No license gate.",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Coursera Toolkit — mở/đóng sidebar"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["assets/content.js"],
      "matches": ["https://www.coursera.org/*"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "cookies", "tabs"],
  "host_permissions": ["https://www.coursera.org/*"]
}
